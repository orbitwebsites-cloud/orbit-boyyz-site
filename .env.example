# x402 bot paywall (src/lib/x402-bot-paywall.ts) — all optional
# Kill switch: set to false to disable the paywall entirely
X402_ENABLED=true
# Wallet that receives USDC
X402_PAY_TO=0x0ba3b8796ce61ef8Cbd11A7F33Be31F1Fd4A03B3
# Price per bot request
X402_PRICE=$0.001
# CAIP-2 network (Base mainnet). eip155:84532 = Base Sepolia testnet
X402_NETWORK=eip155:8453
# Coinbase CDP facilitator (needed for Base mainnet). If both are set they win.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Otherwise this facilitator is used (x402.org only supports testnets)
X402_FACILITATOR_URL=https://x402.org/facilitator
